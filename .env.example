# Server-only TMDB v3 API key. Never rename this to NEXT_PUBLIC_TMDB_API_KEY.
TMDB_API_KEY=replace_with_your_tmdb_v3_key
# Optional Firebase Functions gateway. Set the public URL in the browser build,
# or set TMDB_FUNCTION_URL on the server to keep the browser calling /api/tmdb.
NEXT_PUBLIC_TMDB_FUNCTION_URL=
TMDB_FUNCTION_URL=
# Optional: Firebase can be added later for authenticated, cross-device watchlists.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
